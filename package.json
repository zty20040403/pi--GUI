{
  "name": "pi-desk",
  "version": "0.1.0",
  "private": true,
  "description": "A Codex-style desktop client for the pi coding agent",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n server,web -c blue,green \"tsx watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "postinstall": "node electron/install.cjs",
    "desktop:install": "node electron/install.cjs",
    "desktop": "electron .",
    "desktop:build": "npm run build && tsx scripts/build-desktop.ts && electron-builder --config electron-builder.yml --mac --arm64 --dir",
    "test:desktop": "tsx --test scripts/desktop.test.ts",
    "verify:phase6": "tsx scripts/verify-phase6.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 scripts/backend.test.ts scripts/chat.test.ts scripts/session-actions.test.ts scripts/project-list.test.ts scripts/files.test.ts scripts/preview.test.ts scripts/uploads.test.ts scripts/attachments.test.ts scripts/extensions.test.ts scripts/test-permissions.ts",
    "smoke": "tsx scripts/smoke.ts",
    "verify:phase1": "tsx scripts/verify-phase1.ts",
    "verify:phase2": "tsx scripts/verify-phase2.ts",
    "verify:phase3": "tsx scripts/verify-phase3.ts",
    "verify:phase4": "tsx scripts/verify-phase4.ts",
    "verify:phase5": "tsx scripts/verify-phase5.ts",
    "test:permissions": "tsx --test scripts/test-permissions.ts",
    "fixtures": "tsx scripts/make-fixtures.ts"
  },
  "dependencies": {
    "dompurify": "3.4.17",
    "exceljs": "4.4.0",
    "katex": "0.19.1",
    "mammoth": "1.13.0",
    "mermaid": "11.17.2",
    "papaparse": "5.5.3",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-markdown": "9.0.1",
    "rehype-katex": "7.0.1",
    "remark-gfm": "4.0.0",
    "remark-math": "6.0.0",
    "shiki": "4.5.0",
    "tsx": "4.23.15",
    "ws": "8.22.1"
  },
  "overrides": {
    "katex": "$katex"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.4.0",
    "@playwright/test": "1.64.1",
    "@types/node": "22.10.1",
    "@types/papaparse": "5.3.16",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/ws": "8.5.13",
    "@vitejs/plugin-react": "4.3.4",
    "concurrently": "9.1.0",
    "electron": "35.7.5",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "typescript": "5.6.3",
    "vite": "5.4.21"
  }
}
